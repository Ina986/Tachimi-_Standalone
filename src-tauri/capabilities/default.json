{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "タチミアプリのデフォルトパーミッション（最小権限）。ファイル操作は secure_* カスタムコマンド経由のみ。生 fs/shell/dialog プラグインは付与しない。",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:app:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default"
  ]
}
